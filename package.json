{
  "name": "rclone-manager",
  "version": "0.3.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "node scripts/tauri.cjs",
    "dev:portable": "npm run tauri dev -- --features portable",
    "dev:flatpak": "npm run tauri dev -- --features flatpak",
    "dev:headless": "npm run tauri dev -- --config backend/desktop/tauri.conf.headless.json --features web-server,tray,updater -- --no-default-features",
    "dev:android": "npm run tauri android dev -- --features mobile -- --no-default-features",
    "build:portable": "npm run tauri build -- --features portable --no-bundle",
    "build:flatpak": "npm run tauri build -- --bundles deb --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}' --features flatpak",
    "build:headless": "npm run tauri build -- --config backend/desktop/tauri.conf.headless.json --features web-server,tray,updater -- --no-default-features",
    "test": "ng test",
    "test:ci": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --code-coverage",
    "lint": "eslint \"**/*.{ts,html}\" && cargo clippy --manifest-path backend/Cargo.toml -p rclone-manager -- -D warnings && cargo clippy --manifest-path backend/Cargo.toml -p rclone-manager-server -- -D warnings",
    "format": "prettier --write \"**/*.{ts,html,scss,json}\" && cargo fmt --manifest-path backend/Cargo.toml --all",
    "fix:all": "node scripts/fix-svg-ids.cjs && npm run format && eslint --fix \"**/*.{ts,html}\"",
    "audit:i18n": "node scripts/audit-i18n-keys.cjs",
    "cleanup:i18n": "node scripts/cleanup-i18n-keys.cjs",
    "sync:flags": "node scripts/update-flags.cjs",
    "sync:providers": "node scripts/update-providers.cjs",
    "sync:endpoints": "node scripts/update-endpoints.cjs",
    "optimize:svg": "svgo -f src/assets -r && node scripts/fix-svg-ids.cjs",
    "prepare": "husky",
    "dev:server": "cargo run --manifest-path backend/Cargo.toml -p rclone-manager-server --",
    "build:server": "npm run build && cargo build --manifest-path backend/Cargo.toml -p rclone-manager-server --release"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@ngx-translate/core": "^18.0.0",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "codemirror": "^6.0.2",
    "cronstrue": "^3.37.0",
    "marked": "^18.1.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/jasmine": "~7.0.0",
    "@types/node": "^26.6.5",
    "@angular-eslint/builder": "22.6.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zone.js": "^0.16.3"
  },
  "overrides": {
    "@angular/build": {
      "vite": "^8.3.5"
    }
  },
  "lint-staged": {
    "**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{scss,json}": [
      "prettier --write"
    ],
    "backend/**/*.rs": [
      "sh -c 'cargo fmt --manifest-path backend/Cargo.toml --all'",
      "sh -c 'LIBRCLONE_SKIP_LINK_CHECK=1 cargo clippy --manifest-path backend/Cargo.toml -p rclone-manager -- -D warnings && cargo clippy --manifest-path backend/Cargo.toml -p rclone-manager-server -- -D warnings'"
    ]
  }
}
