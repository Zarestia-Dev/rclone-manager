<?xml version="1.0" encoding="utf-8"?>
<!-- rclone.conf holds remote credentials, so nothing is uploaded to cloud backup. Moving to a
     new device directly still carries the data over. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
