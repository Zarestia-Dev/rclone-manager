# Maintainer: Hakan İSMAİL <hakanismail53@gmail.com>
# The server for a desktop session (menu entry and tray) and as a system service
# (systemd unit and service user). The app updates it with the release's Arch
# package, which holds the same files. It replaces rclone-manager-headless, the
# RClone Manager Headless app (0.3.6 and older), whose settings it keeps using.
pkgname=rclone-manager-server
appname='RClone.Manager.Server'
releasetag=0.3.3
pkgver=0.3.3
pkgrel=1
pkgdesc="Manage Rclone from your browser, with a system tray or as a system service (no GUI libraries)"
arch=('x86_64' 'aarch64')
url="https://github.com/Zarestia-Dev/rclone-manager"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'dbus' 'hicolor-icon-theme')
optdepends=('rclone: for cloud storage operations'
            'fuse3: for mounting remote filesystems')
provides=('rclone-manager-headless')
conflicts=('rclone-manager-headless')
replaces=('rclone-manager-headless')
options=('!strip' '!debug')
install=rclone-manager-server.install
# The release's Arch package (backend/server/package/nfpm.yaml): the server, the
# systemd unit, its user and state folder, and the path the RClone Manager Headless
# app ran from. makepkg unpacks it; its metadata files are left behind.
source_x86_64=("${url}/releases/download/server-v${releasetag}/${appname}-${pkgver}-1-x86_64.pkg.tar.zst")
source_aarch64=("${url}/releases/download/server-v${releasetag}/${appname}-${pkgver}-1-aarch64.pkg.tar.zst")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cp -a "${srcdir}/usr" "${pkgdir}/"
}
