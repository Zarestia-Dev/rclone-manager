[Unit]
Description=RClone Manager Web Server
Documentation=https://github.com/Zarestia-Dev/rclone-manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rclone-manager
Group=rclone-manager

# Security: Run with minimal privileges
NoNewPrivileges=true
PrivateTmp=true

# Main command
# Credentials belong in a root-owned file (chmod 600), not on the command line:
#   /etc/rclone-manager/server.env
#     RCLONE_MANAGER_USER=admin
#     RCLONE_MANAGER_PASS=<long random password>
EnvironmentFile=-/etc/rclone-manager/server.env
ExecStart=/usr/bin/rclone-manager-server \
    --host 0.0.0.0 \
    --port 8080

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=60s
StartLimitBurst=3

# Resource limits (optional, adjust as needed)
MemoryMax=512M
CPUQuota=50%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rclone-manager-server

[Install]
WantedBy=multi-user.target
