# Install:
#   sudo useradd --system --create-home --home-dir /var/lib/rclone-manager --shell /usr/sbin/nologin rclone-manager
#   sudo install -d -o rclone-manager -g rclone-manager /opt/rclone-manager
#   sudo install -o rclone-manager -g rclone-manager -m 755 rclone-manager-server /opt/rclone-manager/
#
# The service user owns the executable and its directory so the application can
# update itself. An executable owned by root (for example in /usr/bin) disables
# in-app updates; replace it manually instead.

[Unit]
Description=RClone Manager Web Server
Documentation=https://github.com/Zarestia-Dev/rclone-manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rclone-manager
Group=rclone-manager

# Security: Run with minimal privileges
NoNewPrivileges=true
PrivateTmp=true

# Main command
# Credentials belong in a root-owned file (chmod 600), not on the command line:
#   /etc/rclone-manager/server.env
#     RCLONE_MANAGER_USER=admin
#     RCLONE_MANAGER_PASS=<long random password>
EnvironmentFile=-/etc/rclone-manager/server.env
ExecStart=/opt/rclone-manager/rclone-manager-server \
    --host 0.0.0.0 \
    --port 8080

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=60s
StartLimitBurst=3

# Resource limits (optional, adjust as needed)
MemoryMax=512M
CPUQuota=50%

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rclone-manager-server

[Install]
WantedBy=multi-user.target
